# DeepSeek / 豆包等 OpenAI 兼容接口。不填则合盘自动降级到本地签谱。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 聚推客联盟统一活动转链 https://www.jutuike.com/doc/48
# 未填 apikey 或活动 ID 时，/api/v1/cps/jump 返回演示载荷，不会伪造佣金链接。
JUTUIKE_APIKEY=
JUTUIKE_ACT_MEITUAN=1
JUTUIKE_ACT_LUCKIN=
JUTUIKE_ACT_CHAGEE=
JUTUIKE_ACT_MOVIE=
JUTUIKE_ACT_TAXI=

# 前端开发默认走 Vite 代理，无需设置。部署时指向后端源。
VITE_API_BASE=

# 旧版命理博客占位（本 H5 不使用）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
