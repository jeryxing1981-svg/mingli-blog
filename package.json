{
  "name": "cyber-lingshan-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n web,api -c gold,red \"vite\" \"tsx server/src/index.ts\"",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --host",
    "server": "tsx server/src/index.ts",
    "test": "tsx --test server/src/logic.test.ts",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "canvas-confetti": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@fastify/cors": "^11.4.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "fastify": "^5.12.8",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "fast-json-stringify": "7.3.2"
  }
}
